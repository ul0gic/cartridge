diff --git a/hw/xbox/nv2a/pgraph/glsl/geom.c b/hw/xbox/nv2a/pgraph/glsl/geom.c
index df933fba50a..ffa0f580ceb 100644
--- a/hw/xbox/nv2a/pgraph/glsl/geom.c
+++ b/hw/xbox/nv2a/pgraph/glsl/geom.c
@@ -21,8 +21,58 @@
 
 #include "qemu/osdep.h"
 #include "hw/xbox/nv2a/pgraph/pgraph.h"
+#include "ui/xemu-settings.h"
 #include "geom.h"
 
+/*
+ * Accurate depth interpolation and polygon offset slope need a geometry shader
+ * for every primitive. Geometry shaders are very slow on some platforms (e.g.
+ * macOS OpenGL), so optionally skip the geometry shader for filled, smooth
+ * shaded triangles and derive depth from gl_FragCoord in the fragment shader
+ * instead.
+ */
+bool pgraph_glsl_use_fast_depth(PGRAPHState *pg)
+{
+    switch (g_config.display.quality.depth_precision) {
+    case CONFIG_DISPLAY_QUALITY_DEPTH_PRECISION_ACCURATE:
+        return false;
+    case CONFIG_DISPLAY_QUALITY_DEPTH_PRECISION_FAST:
+        break;
+    default:
+#ifdef __APPLE__
+        if (pg->renderer->type != CONFIG_DISPLAY_RENDERER_OPENGL) {
+            return false;
+        }
+        break;
+#else
+        return false;
+#endif
+    }
+
+    switch (pg->primitive_mode) {
+    case PRIM_TYPE_TRIANGLES:
+    case PRIM_TYPE_TRIANGLE_STRIP:
+    case PRIM_TYPE_TRIANGLE_FAN:
+    case PRIM_TYPE_POLYGON:
+        break;
+    default:
+        return false;
+    }
+
+    uint32_t raster = pgraph_reg_r(pg, NV_PGRAPH_SETUPRASTER);
+    if (GET_MASK(raster, NV_PGRAPH_SETUPRASTER_FRONTFACEMODE) !=
+            NV_PGRAPH_SETUPRASTER_FRONTFACEMODE_FILL ||
+        GET_MASK(raster, NV_PGRAPH_SETUPRASTER_BACKFACEMODE) !=
+            NV_PGRAPH_SETUPRASTER_FRONTFACEMODE_FILL) {
+        return false;
+    }
+
+    /* Flat shading needs the geometry shader for provoking vertex selection */
+    return GET_MASK(pgraph_reg_r(pg, NV_PGRAPH_CONTROL_3),
+                    NV_PGRAPH_CONTROL_3_SHADEMODE) ==
+           NV_PGRAPH_CONTROL_3_SHADEMODE_SMOOTH;
+}
+
 void pgraph_glsl_set_geom_state(PGRAPHState *pg, GeomState *state)
 {
     state->primitive_mode = (enum ShaderPrimitiveMode)pg->primitive_mode;
@@ -46,6 +96,8 @@ void pgraph_glsl_set_geom_state(PGRAPHState *pg, GeomState *state)
     state->z_perspective = pgraph_reg_r(pg, NV_PGRAPH_CONTROL_0) &
                            NV_PGRAPH_CONTROL_0_Z_PERSPECTIVE_ENABLE;
 
+    state->fast_depth = pgraph_glsl_use_fast_depth(pg);
+
     if (pg->renderer->ops.get_gpu_properties) {
         GPUProperties *gpu_props = pg->renderer->ops.get_gpu_properties();
 
@@ -86,6 +138,10 @@ bool pgraph_glsl_need_geom(const GeomState *state)
     assert(state->polygon_front_mode == state->polygon_back_mode);
     enum ShaderPolygonMode polygon_mode = state->polygon_front_mode;
 
+    if (state->fast_depth) {
+        return false;
+    }
+
     switch (state->primitive_mode) {
     case PRIM_TYPE_POINTS:
         return false;
