-            "if (zvalue > 0.0) {\n"
-            "  float zslopeofs = depthFactor*triMZ*zvalue*zvalue;\n"
-            "  zvalue += depthOffset;\n"
-            "  zvalue += zslopeofs;\n"
-            "} else {\n"
-            "  zvalue = uintBitsToFloat(0x7F7FFFFFu);\n"
